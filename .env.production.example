# Copy to .env.production on the server and replace every REPLACE_* value.
# This file is an input to Docker Compose; it is intentionally not a complete
# application secret store and must never be committed after real values are added.

APP_ENV=prod
LOG_LEVEL=INFO
EDUAGENTS_DOMAIN=learn.example.com
WEB_ORIGIN=https://learn.example.com

POSTGRES_DB=eduagents_prod
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
POSTGRES_APP_PASSWORD=REPLACE_WITH_64_HEX_CHARS
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARS

MINIO_ROOT_USER=eduagents_prod
MINIO_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MINIO_APP_ACCESS_KEY=eduagents_app
MINIO_APP_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
MINIO_BUCKET=eduagents

JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
BCRYPT_ROUNDS=12
CAPTCHA_REQUIRED_REGISTER=true
REGISTRATION_MODE=closed
EMAIL_VERIFICATION_REQUIRED=true

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=no-reply@learn.example.com
SMTP_REPLY_TO=

GATEWAY_MODE=live
GATEWAY_REPLAY_FALLBACK_STUB=false
# 用户自带 DeepSeek Key 的 AES-256-GCM 主密钥；使用密钥系统生成并注入，不能写入 Git。
USER_MODEL_CREDENTIALS_ENABLED=false
USER_MODEL_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
USER_MODEL_CREDENTIALS_KEY_VERSION=1
DEEPSEEK_BYOK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BYOK_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner
# 高频对话档：使用硅基流动。赠送余额不等于模型免费；下面两项必须填写
# 所选模型控制台公布的真实人民币价格（单位：元/百万 tokens）。
CHEAP_API_KEY=REPLACE_WITH_CHEAP_MODEL_KEY
CHEAP_BASE_URL=https://api.siliconflow.cn/v1
CHEAP_MODEL=Qwen/Qwen3.5-9B
CHEAP_ENABLE_THINKING=false
CHEAP_INPUT_PRICE_PER_M=REPLACE_WITH_CHEAP_INPUT_PRICE_CNY_PER_M
CHEAP_OUTPUT_PRICE_PER_M=REPLACE_WITH_CHEAP_OUTPUT_PRICE_CNY_PER_M
# 结构化任务档：继续使用硅基流动。
STANDARD_API_KEY=REPLACE_WITH_STANDARD_MODEL_KEY
STANDARD_BASE_URL=https://api.siliconflow.cn/v1
STANDARD_MODEL=Qwen/Qwen3.6-35B-A3B
STANDARD_ENABLE_THINKING=false
STANDARD_INPUT_PRICE_PER_M=REPLACE_WITH_STANDARD_INPUT_PRICE_CNY_PER_M
STANDARD_OUTPUT_PRICE_PER_M=REPLACE_WITH_STANDARD_OUTPUT_PRICE_CNY_PER_M
VISION_MODEL=Qwen/Qwen3.6-27B
# 通用强档：继续使用硅基流动，供思考对话、研究模式等非计划功能使用。
STRONG_API_KEY=REPLACE_WITH_STRONG_MODEL_KEY
STRONG_BASE_URL=https://api.siliconflow.cn/v1
STRONG_MODEL=Qwen/Qwen3.6-27B
STRONG_ENABLE_THINKING=true
STRONG_INPUT_PRICE_PER_M=REPLACE_WITH_STRONG_INPUT_PRICE_CNY_PER_M
STRONG_OUTPUT_PRICE_PER_M=REPLACE_WITH_STRONG_OUTPUT_PRICE_CNY_PER_M
# 学习计划专用档：使用 DeepSeek；不会影响其他功能的供应商选择。
PLAN_API_KEY=REPLACE_WITH_PLAN_MODEL_KEY
PLAN_BASE_URL=https://api.deepseek.com
PLAN_MODEL=deepseek-v4-flash
PLAN_INPUT_PRICE_PER_M=1.0
PLAN_OUTPUT_PRICE_PER_M=2.0
TAVILY_API_KEY=

EMBEDDING_MODE=live
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_KEY
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODE=live
RERANK_MODEL=BAAI/bge-reranker-v2-m3

AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=30
# 约 10 人内测的保守起点；预算按模型真实成本计算，钱包按真实成本×倍率扣除。
BILLING_MARKUP=3.0
SIGNUP_GRANT_CNY=3.0
USER_DAILY_BUDGET_CNY=0.5
GLOBAL_DAILY_BUDGET_CNY=2.0
# 人工核验邀请活动；关闭时后端不会向钱包页返回链接。
REFERRAL_CAMPAIGN_ENABLED=true
SILICONFLOW_REFERRAL_URL=https://cloud.siliconflow.cn/i/xHP6BLhM
REFERRAL_REWARD_CREDITS=30.0
MAX_UPLOAD_MB=50
MAX_CHAT_ATTACHMENT_MB=20
MAX_DOCS_PER_USER=200
MAX_STORAGE_MB_PER_USER=1024
MAX_CHUNKS_PER_DOC=3000
MAX_CHUNKS_PER_USER=20000
WEB_IMPORT_ALLOW_PRIVATE_HOSTS=false
ENABLE_TIME_TRAVEL=0
PAYMENT_PROVIDER=disabled
ENABLE_FAULT_INJECTION=0

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_LOG_CONTENT=0
