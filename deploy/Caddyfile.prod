# Caddy obtains and renews the certificate for this hostname automatically.
# EDUAGENTS_DOMAIN is injected by the production compose environment.
{$EDUAGENTS_DOMAIN} {
	encode gzip

	# Keep API documentation private in the public deployment. Operators can
	# inspect the schema from an internal network or a separate admin service.
	@private_docs path /api/docs /api/docs/* /api/openapi.json
	respond @private_docs 404

	# Do not buffer SSE events. Caddy's default HTTP transport remains in use.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
