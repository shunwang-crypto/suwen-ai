# Langfuse 自托管密钥模板 — 复制为 .env 并填真实随机值
# 生成: openssl rand -hex 24 (ENCRYPTION_KEY 用 openssl rand -hex 32)
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
SALT=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
# SDK 接线用的 API key 对 (无头初始化直接写入, 格式 pk-lf-*/sk-lf-*)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# 控制台登录账号
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
