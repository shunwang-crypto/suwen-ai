# ===== 运行环境 =====
APP_ENV=dev                # dev | test | prod
LOG_LEVEL=INFO

# ===== 本地数据层 =====
DATABASE_URL=postgresql+asyncpg://edu_app:edu@127.0.0.1:5432/eduagents
MIGRATION_DATABASE_URL=postgresql+asyncpg://edu:edu@127.0.0.1:5432/eduagents
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
# 非空 -> qdrant-client 纯本地模式；使用本地 Qdrant 服务时留空
QDRANT_LOCAL_PATH=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=eduagents
MINIO_SECRET_KEY=eduagents-secret
MINIO_BUCKET=eduagents

# ===== 认证 =====
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
BCRYPT_ROUNDS=12
REGISTRATION_MODE=open
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_PER_MINUTE=5
EMAIL_CODE_DAILY_LIMIT=20
EMAIL_CODE_IP_DAILY_LIMIT=100

# ===== 图形验证码 (自托管 Pillow 生成, 零外部依赖) =====
# 注册是否强制验证码 (默认 true); 本地脚本/无验证码前端联调可临时置 0
CAPTCHA_REQUIRED_REGISTER=true
CAPTCHA_RATE_LIMIT_PER_MINUTE=30

# ===== 密码找回 =====
# 重置链接前缀: {WEB_ORIGIN}/reset?token=...
WEB_ORIGIN=http://127.0.0.1:3000
PASSWORD_RESET_TTL_SECONDS=1800
AUTH_FORGOT_RATE_LIMIT_PER_MINUTE=5

# ===== SMTP 发信 =====
# 未配置时走 DevEmailSender: 明确标注未真实发信；仅 APP_ENV=dev 时写入
# Redis debug:reset:{email} (TTL 10min) 供本地演示取用，不把链接写入日志或 HTTP 响应。
# 真实发信凭据只写入未提交的 .env。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 真实发信时改为已验证的发件地址
SMTP_FROM=EduAgents <noreply@verified-domain.example>
SMTP_REPLY_TO=

# ===== 模型网关 =====
# live: 真实调用 | record: 真实调用并录制 | replay: 只回放录制 | stub: 确定性开发桩
GATEWAY_MODE=stub
GATEWAY_CASSETTE_DIR=cassettes
GATEWAY_REPLAY_FALLBACK_STUB=true

# ===== 单一 TrendDAO 模型路由 =====
MODEL_ROUTING_ENABLED=false
# 不要把真实 API key 提交到仓库。
TRENDDAO_BASE_URL=https://trenddao.com/v1
TRENDDAO_API_KEY=
TRENDDAO_TEXT_MODEL=muse-spark-1.2-contributor
TRENDDAO_VISION_MODEL=muse-spark-1.2-contributor
TRENDDAO_INPUT_PRICE_PER_M=0
TRENDDAO_OUTPUT_PRICE_PER_M=0

# ===== 用户自带文本模型（BYOK，0017） =====
# 默认关闭。开启前请用 `python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"`
# 生成随机主密钥，并只写入服务器环境变量；不要把输出提交到 Git。
USER_MODEL_CREDENTIALS_ENABLED=false
USER_MODEL_CREDENTIALS_ENCRYPTION_KEY=
USER_MODEL_CREDENTIALS_KEY_VERSION=1
DEEPSEEK_BYOK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BYOK_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner

# cheap 档 (SiliconFlow, 路由/校验/分类等轻任务)
CHEAP_API_KEY=
CHEAP_BASE_URL=https://api.siliconflow.cn/v1
CHEAP_MODEL=Qwen/Qwen3.5-9B
CHEAP_ENABLE_THINKING=false

# standard 档
STANDARD_API_KEY=
STANDARD_BASE_URL=https://api.siliconflow.cn/v1
STANDARD_MODEL=Qwen/Qwen3.6-35B-A3B
STANDARD_ENABLE_THINKING=false
# 图片附件需要同一接口可访问该视觉模型；留空将关闭图片上传。
VISION_MODEL=Qwen/Qwen3.6-27B

# strong 档（通用复杂任务）
STRONG_API_KEY=
STRONG_BASE_URL=https://api.siliconflow.cn/v1
STRONG_MODEL=Qwen/Qwen3.6-27B
STRONG_ENABLE_THINKING=true

# plan 档（只供学习计划图使用，可独立使用 DeepSeek）
PLAN_API_KEY=
PLAN_BASE_URL=https://api.deepseek.com
PLAN_MODEL=deepseek-v4-flash
PLAN_INPUT_PRICE_PER_M=1
PLAN_OUTPUT_PRICE_PER_M=2

# ===== 联网搜索 =====
TAVILY_API_KEY=

# ===== Embedding / Rerank (SiliconFlow) =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 限流与预算 =====
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=120
USER_DAILY_BUDGET_CNY=5.0
BILLING_MARKUP=3.0
SIGNUP_GRANT_CNY=10.0

# 硅基流动邀请活动：仅跳转并由管理员人工核验发放，点击不会自动到账。
REFERRAL_CAMPAIGN_ENABLED=false
SILICONFLOW_REFERRAL_URL=
REFERRAL_REWARD_CREDITS=30.0

# ===== URL 网页导入 =====
# 仅本地集成测试打开：true 会整体旁路 SSRF 防护（内网/回环/元数据地址拦截）
WEB_IMPORT_ALLOW_PRIVATE_HOSTS=false

# ===== 上传约束 =====
MAX_UPLOAD_MB=50
MAX_CHAT_ATTACHMENT_MB=20
MAX_CHAT_ATTACHMENTS_PER_MESSAGE=4
PDF_QUESTION_STRUCTURING_MAX_TOKENS=8000
MAX_TUTOR_ATTACHMENT_PAGES=50
MAX_TUTOR_DEFAULT_PAGES=3
MAX_TUTOR_RECOGNITION_PAGES=8
MAX_TUTOR_OCR_DPI=144
MAX_TUTOR_OCR_IMAGE_MB=4
MAX_TUTOR_OCR_CONCURRENCY=2
TUTOR_OCR_TIMEOUT_SECONDS=45
TUTOR_RECOGNITION_TIMEOUT_SECONDS=120
TUTOR_DRAFT_TTL_HOURS=24
MAX_TUTOR_RECOGNITION_ATTEMPTS=3
MAX_ERROR_IMPORT_DRAFTS=20
ERROR_IMPORT_DRAFT_TTL_HOURS=24
MAX_DOCS_PER_USER=200
MAX_STORAGE_MB_PER_USER=1024

# 全局预算与资源上限
GLOBAL_DAILY_BUDGET_CNY=50.0
MAX_CHUNKS_PER_DOC=3000
MAX_CHUNKS_PER_USER=20000
# 正常本地使用保持关闭，只在测试时间相关逻辑时开启
# ENABLE_TIME_TRAVEL=0

# ===== Langfuse 可观测性（可选） =====
# 三项齐全才启用（缺任一即整体关闭）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 默认只上报 prompt/completion 的长度与摘要哈希；本地调试原文时才设为 1
LANGFUSE_LOG_CONTENT=0
